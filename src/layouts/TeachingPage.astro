---
import { type CollectionEntry, render } from "astro:content";
import TOC from "@/components/blog/TOC.astro";
import GlitchText from "@/components/GlitchText.astro";
import { tilt } from "@/utils/tilt";
import BaseLayout from "./Base.astro";

interface Props {
	page: CollectionEntry<"teaching">;
}

const { page } = Astro.props;
const { title, description, course, partnerLogo, toc, noindex } = page.data;
const { headings, remarkPluginFrontmatter } = await render(page);
const readingTime: string = remarkPluginFrontmatter.readingTime;
// the course home is the first segment of the page's path, e.g. /teaching/imageomics2026/
const courseHome = `/teaching/${page.id.split("/")[0]}/`;
const isCourseHome = Astro.url.pathname === courseHome;
---

<BaseLayout meta={{ description, noindex, title }}>
	<article class="grow break-words">
		<div class="mb-10">
			<div class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-3">
				{
					partnerLogo && (
						<a href={partnerLogo.href ?? courseHome} class="block">
							<img
								alt={partnerLogo.alt}
								class="partner-logo h-14 w-auto sm:h-16"
								src={partnerLogo.src}
							/>
						</a>
					)
				}
				{
					course && (
						<p class="text-muted font-display text-xs leading-snug">
							{isCourseHome ? course : <a class="cactus-link" href={courseHome}>{course}</a>}
						</p>
					)
				}
			</div>
			<h1
				class="title tilt"
				style={`--tilt: ${tilt(title, 1.5)}`}
				data-tilt-max="1.5"
			>
				<GlitchText text={title} />
			</h1>
			<p class="text-muted mt-3">{description}</p>
			{toc && <p class="text-muted mt-1 text-xs font-semibold">{readingTime}</p>}
		</div>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{toc && !!headings.length && <TOC headings={headings} />}
			<div
				class="teach-md prose prose-sm prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-muted prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>
