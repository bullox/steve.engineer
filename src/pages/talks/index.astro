---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import { tilt } from "@/utils/tilt";

const talks = (
	await getCollection("talk", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => a.data.order - b.data.order);

const meta = {
	title: "Talks",
	description:
		"Talks I give on drones, conservation, education, and engineering. Get in touch to request one.",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">Talks</h1>
	<p class="text-muted mb-10">
		Talks I've given, and am happy to give again. Each page has an abstract, where it's been
		delivered, and how to <a class="cactus-link" href="/contact/">request it</a> for your event.
	</p>
	<ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2" role="list">
		{
			talks.map((talk) => (
				<li
					class="tilt group"
					style={`--tilt: ${tilt(talk.id, 1.5)}`}
					data-tilt-max="1.5"
				>
					<a class="block" href={`/talks/${talk.id}/`}>
						<Image
							alt={talk.data.thumbnail.alt}
							class="aspect-video w-full rounded-sm object-cover grayscale transition group-hover:grayscale-0 motion-reduce:transition-none"
							src={talk.data.thumbnail.src}
							widths={[480, 960]}
							sizes="(min-width: 640px) 50vw, 100vw"
						/>
						<h2 class="font-display text-accent-2 mt-3 text-base font-semibold group-hover:underline">
							{talk.data.title}
						</h2>
					</a>
					<p class="text-muted mt-1 text-sm">
						{talk.data.duration && <span>{talk.data.duration} · </span>}
						{talk.data.description}
					</p>
				</li>
			))
		}
	</ul>
</PageLayout>
